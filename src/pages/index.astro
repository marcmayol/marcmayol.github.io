---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HomeContent from '../components/HomeContent.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { personSchema, websiteSchema } from '../consts';
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const inverse = lang === 'en' ? 'es' : 'en';

const item = {
	'@context': 'https://schema.org',
	'@graph': [
		websiteSchema,
		{ ...personSchema(lang), 'description': t('home.seodescription') },
	],
}
---

<!doctype html>
<html lang={lang}>
<head>
    <BaseHead title={t('home.seotitle')} description={t('home.seodescription')} item={item} image="/perfil.jpg"/>
</head>
<body class="mm-body">
<Header customURL={'/'+inverse} />
<HomeContent />
<Footer />
</body>
</html>

