---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const ym = (d: Date) => `${d.getFullYear()}·${String(d.getMonth() + 1).padStart(2, '0')}`;
---

<div class="mm-blog mm-slab">

	<!-- HERO -->
	<section class="mm-bl-hero">
		<span class="mm-badge">{t('blog.badge')}</span>
		<h1 class="mm-bl-h1">{t('blog.h1pre')}<br /><span class="mm-red">{t('blog.h1accent')}</span></h1>
		<p class="mm-bl-intro">{t('blog.intro')}</p>
	</section>

	<!-- POSTS -->
	<div class="mm-bl-list">
		{posts.length === 0 ? (
			<div class="mm-bl-empty">{t('blog.empty')}</div>
		) : posts.map((post) => (
			<a href={`/blog/${post.id}/`} class="mm-post">
				<div class="mm-post-date">{ym(post.data.pubDate)}</div>
				<div class="mm-post-body">
					<h2 class="mm-post-title">{post.data.title}</h2>
					<p class="mm-post-desc">{post.data.description}</p>
				</div>
				<div class="mm-post-read">{t('blog.read')}</div>
			</a>
		))}
	</div>

	<!-- NEWSLETTER -->
	<div class="mm-bl-news">
		<div>
			<p class="mm-sec-tag mm-bl-news-tag">{t('blog.newslettertag')}</p>
			<h2 class="mm-bl-news-title">{t('blog.newslettertitle')}</h2>
		</div>
		<a href="https://www.linkedin.com/in/marc-mayol-orell/" target="_blank" rel="noopener noreferrer" class="mm-btn mm-btn--ink">{t('blog.newsletterbtn')}</a>
	</div>

</div>

<style>
	/* HERO */
	.mm-bl-hero{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-bl-h1{
		font-size:var(--text-4xl);line-height:.94;font-weight:900;letter-spacing:-.03em;
		margin:0 0 var(--space-md);text-transform:uppercase;overflow-wrap:anywhere;
	}
	.mm-bl-intro{font-family:var(--mm-font-mono);font-size:var(--text-base);line-height:1.65;color:var(--mm-body);max-width:560px;margin:0}

	/* POSTS */
	.mm-bl-list{border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-post{
		text-decoration:none;color:var(--mm-ink);
		display:grid;grid-template-columns:110px minmax(0,1fr) 130px;
		border-bottom:var(--mm-hair) solid var(--mm-rule);
		transition:background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-post:last-child{border-bottom:none}
	.mm-post:hover{background:var(--mm-paper-2)}
	.mm-post:hover .mm-post-read,.mm-post:hover .mm-post-title{color:var(--mm-accent-ink)}
	.mm-post-date{
		padding:var(--space-md) var(--space-md);font-family:var(--mm-font-mono);font-size:var(--text-2xs);
		color:var(--mm-muted);border-right:var(--mm-hair) solid var(--mm-rule);
	}
	.mm-post-body{padding:var(--space-md);min-width:0}
	.mm-post-title{
		font-weight:800;font-size:var(--text-lg);text-transform:uppercase;line-height:1.08;
		margin:0;overflow-wrap:anywhere;
	}
	.mm-post-desc{
		font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-body-2);line-height:1.6;
		margin:var(--space-2xs) 0 0;overflow-wrap:anywhere;
		display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
	}
	.mm-post-read{
		padding:var(--space-md);font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-muted);
		display:flex;align-items:center;justify-content:flex-end;white-space:nowrap;
	}
	.mm-bl-empty{padding:var(--space-xl);font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-muted);text-align:center}

	/* NEWSLETTER */
	.mm-bl-news{
		padding:var(--space-xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink);background:var(--mm-paper-2);
		display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:var(--space-md);
	}
	.mm-bl-news-tag{margin:0 0 var(--space-2xs)}
	.mm-bl-news-title{font-weight:800;font-size:var(--text-xl);text-transform:uppercase;line-height:1.05;max-width:460px;margin:0;overflow-wrap:anywhere}

	@media (max-width:860px){
		.mm-bl-h1{font-size:var(--text-3xl)}
		/* Una sola columna: la fecha arriba y el "leer" abajo, sin perder la afordancia. */
		.mm-post{grid-template-columns:minmax(0,1fr)}
		.mm-post-date{
			border-right:none;border-bottom:var(--mm-hair) solid var(--mm-rule);
			padding:var(--space-xs) var(--mm-pad-x);
		}
		.mm-post-body{padding:var(--space-md) var(--mm-pad-x) var(--space-2xs)}
		.mm-post-read{padding:0 var(--mm-pad-x) var(--space-md);justify-content:flex-start}
	}
</style>
