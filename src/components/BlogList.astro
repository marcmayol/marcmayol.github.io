---
import type { CollectionEntry } from 'astro:content';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

interface Props {
	posts: CollectionEntry<'blog'>[];
}
const { posts } = Astro.props as Props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const fmt = (d: Date) => d.toLocaleDateString(lang === 'es' ? 'es-ES' : 'en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---

<div class="mm-blog">

	<header class="mm-bl-hero">
		<h1 class="mm-bl-h1">{t('blog.h1pre')} <span class="mm-acc">{t('blog.h1accent')}</span></h1>
		<p class="mm-bl-lede">{t('blog.intro')}</p>
	</header>

	<section class="mm-bl-band">
		{posts.length === 0 ? (
			<p class="mm-bl-empty">{t('blog.empty')}</p>
		) : (
			<ul class="mm-bl-list">
				{posts.map((post) => (
					<li>
						<a href={`/blog/${post.id}/`} class="mm-bl-post">
							<div class="mm-bl-body">
								<h2 class="mm-bl-t">{post.data.title}</h2>
								<span class="mm-bl-d">{post.data.description}</span>
							</div>
							<time class="mm-bl-date" datetime={post.data.pubDate.toISOString()}>{fmt(post.data.pubDate)}</time>
						</a>
					</li>
				))}
			</ul>
		)}
	</section>

</div>

<style>
	/* Hallmark · genre: atmospheric · macrostructure: Index-First · design-system: design.md · designed-as-app */
	.mm-blog{background:var(--mm-paper);color:var(--mm-ink);font-family:var(--mm-font-body)}

	.mm-bl-hero{max-width:var(--mm-maxw);margin:0 auto;padding:var(--space-3xl) var(--mm-pad-x) var(--space-2xl);box-sizing:border-box}
	.mm-bl-h1{font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-hero);line-height:.98;letter-spacing:-.04em;margin:0 0 var(--space-md);text-wrap:balance;max-width:16ch}
	.mm-acc{color:var(--mm-accent-ink)}
	.mm-bl-lede{font-size:var(--text-lede);line-height:1.55;font-weight:300;color:var(--mm-ink-soft);max-width:48ch;margin:0}

	.mm-bl-band{max-width:var(--mm-maxw);margin:0 auto;padding:var(--space-lg) var(--mm-pad-x) var(--space-3xl);border-top:var(--mm-hair) solid var(--mm-rule);box-sizing:border-box}
	.mm-bl-list{list-style:none;margin:0;padding:0;max-width:960px}
	.mm-bl-post{
		display:flex;justify-content:space-between;align-items:baseline;gap:var(--space-lg);
		padding:var(--space-md) 0;border-bottom:var(--mm-hair) solid var(--mm-rule);
		color:var(--mm-ink);text-decoration:none;
	}
	.mm-bl-post:hover .mm-bl-t{color:var(--mm-accent-ink)}
	.mm-bl-body{display:block;min-width:0}
	.mm-bl-t{font-family:var(--mm-font-display);font-size:var(--text-xl);font-weight:500;letter-spacing:-.02em;line-height:1.25;margin:0 0 var(--space-2xs);text-wrap:pretty;overflow-wrap:break-word;transition:color var(--mm-dur-1) var(--mm-ease-out)}
	.mm-bl-d{
		display:-webkit-box;-webkit-line-clamp:2;line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;
		font-size:var(--text-md);line-height:1.55;font-weight:300;color:var(--mm-ink-soft);max-width:64ch;
	}
	.mm-bl-date{font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-muted);white-space:nowrap}
	.mm-bl-empty{font-size:var(--text-md);font-weight:300;color:var(--mm-ink-soft);margin:0;padding:var(--space-lg) 0}

	@media (max-width:860px){
		.mm-bl-hero{padding:var(--space-2xl) var(--mm-pad-x) var(--space-xl)}
		.mm-bl-band{padding:var(--space-sm) var(--mm-pad-x) var(--space-2xl)}
		.mm-bl-post{flex-direction:column;gap:var(--space-2xs)}
		.mm-bl-t{font-size:var(--text-lg)}
	}
	@media (prefers-reduced-motion:reduce){.mm-bl-t{transition:none}}
</style>
