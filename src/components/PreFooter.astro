---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section id="contact" class="mm-contact mm-prefooter">
	<div class="mm-contact-copy">
		<h2 class="mm-contact-title">{t('home.contacttitle')}</h2>
		<p class="mm-contact-desc">{t('home.contactdescription')}</p>
	</div>
	<div class="mm-contact-btns">
		<a href={`/contacto/${lang}/`} class="mm-cbtn mm-cbtn--red">{t('nav.contact')}</a>
		<a href="https://www.linkedin.com/in/marc-mayol-orell/" target="_blank" rel="noopener noreferrer" class="mm-cbtn">LINKEDIN</a>
		<a href="https://github.com/marcmayol" target="_blank" rel="noopener noreferrer" class="mm-cbtn">GITHUB</a>
	</div>
</section>

<style>
	.mm-prefooter{
		max-width:var(--mm-maxw);margin:0 auto;
		border-left:var(--mm-border) solid var(--mm-ink);
		border-right:var(--mm-border) solid var(--mm-ink);
		font-family:var(--mm-font-display);
	}
</style>
