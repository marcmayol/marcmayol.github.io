---
// El JSON-LD de FAQPage ya lo emite BlogPost.astro a partir del frontmatter:
// emitirlo también aquí duplicaba el bloque FAQPage en la misma página.
const { items = [], lang } = Astro.props;
const title = lang === 'en' ? 'FAQs' : 'Preguntas frecuentes';
---

{items.length > 0 && (
	<section id="faq" class="mm-faq">
		<h2 class="mm-faq-h">{title}</h2>
		<div class="mm-faq-list">
			{items.map((item) => (
				<details class="mm-faq-item">
					<summary class="mm-faq-q">
						<span class="mm-faq-qtext">{item.pregunta}</span>
						<span class="mm-faq-mark" aria-hidden="true"></span>
					</summary>
					<p class="mm-faq-a">{item.respuesta}</p>
				</details>
			))}
		</div>
	</section>
)}

<style>
	/* Hallmark · genre: atmospheric · macrostructure: Long Document · design-system: design.md · designed-as-app */
	.mm-faq{margin:var(--space-2xl) 0 var(--space-md);border-top:var(--mm-hair) solid var(--mm-rule);padding-top:var(--space-lg)}
	.mm-faq-h{
		font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-2xl);line-height:1.1;letter-spacing:-.03em;
		color:var(--mm-ink);margin:0 0 var(--space-md);
	}
	.mm-faq-list{border-bottom:var(--mm-hair) solid var(--mm-rule)}
	.mm-faq-item{border-top:var(--mm-hair) solid var(--mm-rule)}
	.mm-faq-q{
		display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-sm);
		min-height:44px;box-sizing:border-box;padding:var(--space-sm) 0;cursor:pointer;list-style:none;
		font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-md);line-height:1.4;color:var(--mm-ink);
		transition:color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-faq-q::-webkit-details-marker{display:none}
	.mm-faq-q:hover{color:var(--mm-accent-ink)}
	.mm-faq-qtext{min-width:0;overflow-wrap:break-word}
	.mm-faq-mark{font-family:var(--mm-font-mono);font-size:var(--text-md);color:var(--mm-accent-ink);flex:none;line-height:1.4}
	.mm-faq-mark::before{content:"+"}
	.mm-faq-item[open] .mm-faq-mark::before{content:"–"}
	/* Sin altura máxima: una respuesta larga se lee entera. */
	.mm-faq-a{
		margin:0;padding:0 0 var(--space-md);
		font-size:var(--text-md);line-height:1.7;font-weight:300;color:var(--mm-ink-soft);
		overflow-wrap:break-word;
	}
	@media (prefers-reduced-motion:reduce){.mm-faq-q{transition:none}}
</style>
