---
// El JSON-LD de FAQPage ya lo emite BlogPost.astro a partir del frontmatter:
// emitirlo también aquí duplicaba el bloque FAQPage en la misma página.
const { items = [], lang } = Astro.props;
const title = lang === 'en' ? 'FAQs' : 'Preguntas frecuentes';
---

{items.length > 0 && (
	<section id="faq" class="mm-faq">
		<h2 class="mm-faq-h">{title}</h2>
		<div class="mm-faq-list">
			{items.map((item) => (
				<details class="mm-faq-item">
					<summary class="mm-faq-q">
						<span class="mm-faq-qtext">{item.pregunta}</span>
						<span class="mm-faq-mark" aria-hidden="true"></span>
					</summary>
					<p class="mm-faq-a">{item.respuesta}</p>
				</details>
			))}
		</div>
	</section>
)}

<style>
	.mm-faq{
		margin:var(--space-xl) 0 var(--space-md);
		border-top:var(--mm-border) solid var(--mm-ink);
		padding-top:var(--space-md);
	}
	.mm-faq-h{
		font-family:var(--mm-font-mono);font-size:var(--text-sm);font-weight:700;
		text-transform:uppercase;letter-spacing:.02em;margin:0 0 var(--space-sm);
	}
	.mm-faq-h::before{content:"/ ";color:var(--mm-accent-ink)}
	.mm-faq-list{border:var(--mm-border) solid var(--mm-ink);background:var(--mm-paper-2)}
	.mm-faq-item + .mm-faq-item{border-top:var(--mm-hair) solid var(--mm-rule)}
	.mm-faq-q{
		display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-sm);
		padding:var(--space-sm);cursor:pointer;list-style:none;
		font-family:var(--mm-font-display);font-weight:800;font-size:1rem;line-height:1.35;
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-faq-q::-webkit-details-marker{display:none}
	.mm-faq-q:hover{background:var(--mm-paper);color:var(--mm-accent-ink)}
	.mm-faq-qtext{min-width:0;overflow-wrap:anywhere}
	.mm-faq-mark{
		font-family:var(--mm-font-mono);font-weight:700;color:var(--mm-accent-ink);
		flex:none;line-height:1.35;
	}
	.mm-faq-mark::before{content:"+"}
	.mm-faq-item[open] .mm-faq-mark::before{content:"–"}
	.mm-faq-item[open] .mm-faq-q{background:var(--mm-paper)}
	/* Sin altura máxima: una respuesta larga se lee entera. */
	.mm-faq-a{
		margin:0;padding:0 var(--space-sm) var(--space-sm);
		font-size:var(--text-base);line-height:1.7;color:var(--mm-ink-soft);
		overflow-wrap:anywhere;
	}
</style>
