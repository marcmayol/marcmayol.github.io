---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import {Schema} from 'astro-seo-schema';
import '../styles/global.css';
import {SITE_TITLE, APPLICATION_NAME} from '../consts';

interface Props {
	title: string;
	description: string;
	image?: string;
	item?: Schema;
	// Ruta de la otra versión de idioma: undefined = se deduce de la URL, null = no hay traducción
	altURL?: string | null;
	ogType?: 'website' | 'article';
}

const { title, description, image = '/perfil.jpg', altURL, ogType = 'website' } = Astro.props;

const withSlash = (p: string) => (p.endsWith('/') || p.includes('.') ? p : p + '/');

// Las rutas sin prefijo de idioma son copias de la versión en español: todas apuntan a una sola URL
const duplicates: Record<string, string> = {
	'/es/': '/',
	'/about/': '/about/es/',
	'/blog/': '/blog/es/',
	'/contacto/': '/contacto/es/',
	'/archjourney/': '/es/archjourney/',
};
const path = withSlash(decodeURI(Astro.url.pathname));
const canonicalPath = duplicates[path] ?? path;
const canonicalURL = new URL(canonicalPath, Astro.site);

// Pareja ES/EN de esta página para hreflang
const swapLang = (p: string) => {
	if (p === '/') return { es: '/', en: '/en/' };
	if (p === '/en/') return { es: '/', en: '/en/' };
	if (/\/(es|en)\//.test(p)) return { es: p.replace(/\/en\//, '/es/'), en: p.replace(/\/es\//, '/en/') };
	return null;
};
let pair: { es: string; en: string } | null = null;
if (altURL === undefined) {
	pair = swapLang(canonicalPath);
} else if (altURL) {
	const other = withSlash(altURL);
	pair = canonicalPath.includes('/en/') ? { es: other, en: canonicalPath } : { es: canonicalPath, en: other };
}
const alternates = pair && [
	{ lang: 'es', href: new URL(pair.es, Astro.site) },
	{ lang: 'en', href: new URL(pair.en, Astro.site) },
	{ lang: 'x-default', href: new URL(pair.es, Astro.site) },
];
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Design fonts: Archivo + Space Mono, alojadas en /fonts (ver global.css) -->
<link rel="preload" href="/fonts/archivo-latin-var.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/space-mono-latin-400.woff2" as="font" type="font/woff2" crossorigin />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />
{alternates && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image, Astro.site)} />
<link rel="manifest" href="/manifest.json"/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalURL} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL(image, Astro.site)} />
<!-- Meta etiqueta para navegadores Android -->
<meta name="theme-color" content="#ffffff"/>
<meta name="robots" content="index,follow"/>
<meta name="googlebot" content="index,follow"/>
<link rel="author" href="/humans.txt"/>
<meta name="application-name" content={APPLICATION_NAME}/>
<!-- Favicon principal -->
<link rel="icon" type="image/x-icon" href="/favicon.ico"/>
<!-- Iconos para dispositivos Apple y Android/Chrome -->
<link rel="apple-touch-icon" sizes="192x192" href="/logos/logo192.png"/>
<link rel="icon" type="image/png" sizes="192x192" href="/logos/logo192.png"/>
<link rel="icon" type="image/png" sizes="512x512" href="/logos/logo512.png"/>
<Schema
	item={Astro.props.item}
/>
<!-- Google Tag Manager -->
<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
		new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
	j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
	'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-MD3MVBL');</script>
<!-- End Google Tag Manager -->

