---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import ContactForm from './ContactForm.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const channels = [
	{ id: 'email', label: 'Email', value: 'marcmayolorell@gmail.com', href: 'mailto:marcmayolorell@gmail.com', external: false },
	{ id: 'linkedin', label: 'LinkedIn', value: 'in/marc-mayol-orell', href: 'https://www.linkedin.com/in/marc-mayol-orell/', external: true },
	{ id: 'github', label: 'GitHub', value: 'github.com/marcmayol', href: 'https://github.com/marcmayol', external: true },
];
---

<div class="mm-contactpage">
	<section class="mm-cp-band">
		<header class="mm-cp-head">
			<h1 class="mm-cp-h1" set:html={t('contact.h1')}></h1>
			<p class="mm-cp-lede">{t('contact.intro')}</p>
		</header>

		<div class="mm-cp-grid">
			<div class="mm-cp-form">
				<ContactForm />
			</div>

			<aside class="mm-cp-side">
				<h2 class="mm-sr-only">{t('contact.channelstitle')}</h2>
				<ul class="mm-chans">
					{channels.map((channel) => (
						<li>
							<a
								href={channel.href}
								class="mm-chan"
								{...(channel.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
							>
								<span class="mm-chan-k">{channel.label}</span>
								<span class="mm-chan-v">{channel.value}</span>
							</a>
						</li>
					))}
				</ul>
				<p class="mm-cp-note">{t('contact.directtext')}</p>
			</aside>
		</div>
	</section>
</div>

<style>
	/* Hallmark · genre: atmospheric · macrostructure: single band (form) · design-system: design.md · designed-as-app */
	.mm-contactpage{background:var(--mm-paper);color:var(--mm-ink);font-family:var(--mm-font-body)}
	.mm-cp-band{max-width:var(--mm-maxw);margin:0 auto;padding:var(--space-3xl) var(--mm-pad-x) var(--space-4xl);box-sizing:border-box}

	.mm-cp-head{margin-bottom:var(--space-2xl)}
	.mm-cp-h1{font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-hero);line-height:.98;letter-spacing:-.04em;margin:0 0 var(--space-md);text-wrap:balance}
	.mm-cp-lede{font-size:var(--text-lede);line-height:1.55;font-weight:300;color:var(--mm-ink-soft);max-width:44ch;margin:0}

	.mm-cp-grid{
		display:grid;grid-template-columns:minmax(0,1.4fr) minmax(0,1fr);gap:var(--space-3xl);
		padding-top:var(--space-2xl);border-top:var(--mm-hair) solid var(--mm-rule);
	}
	.mm-cp-form,.mm-cp-side{min-width:0}

	.mm-chans{list-style:none;margin:0;padding:0;border-bottom:var(--mm-hair) solid var(--mm-rule)}
	.mm-chan{
		display:flex;flex-direction:column;gap:var(--space-3xs);min-height:44px;box-sizing:border-box;
		padding:var(--space-sm) 0;border-top:var(--mm-hair) solid var(--mm-rule);
		color:var(--mm-ink);text-decoration:none;
	}
	.mm-chan:hover .mm-chan-v{color:var(--mm-accent-ink)}
	.mm-chan-k{font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-muted)}
	.mm-chan-v{font-size:var(--text-md);font-weight:500;overflow-wrap:anywhere;transition:color var(--mm-dur-1) var(--mm-ease-out)}
	.mm-cp-note{font-size:var(--text-md);line-height:1.6;font-weight:300;color:var(--mm-ink-soft);margin:var(--space-md) 0 0;max-width:36ch}

	@media (max-width:860px){
		.mm-cp-band{padding:var(--space-2xl) var(--mm-pad-x) var(--space-3xl)}
		.mm-cp-head{margin-bottom:var(--space-xl)}
		.mm-cp-grid{grid-template-columns:minmax(0,1fr);gap:var(--space-2xl);padding-top:var(--space-xl)}
	}
	@media (prefers-reduced-motion:reduce){.mm-chan-v{transition:none}}
</style>
