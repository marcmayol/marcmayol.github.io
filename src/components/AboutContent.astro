---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { projects } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projectList = projects[lang] ?? projects.es;
---

<div class="mm-about mm-slab">

	<!-- HERO -->
	<section class="mm-ab-hero">
		<div class="mm-ab-photo">
			<img class="mm-ab-img" src="/perfil.png" alt={t('home.photoalt')} width="720" height="900" fetchpriority="high" />
		</div>
		<div class="mm-ab-copy">
			<span class="mm-badge">{t('about.badge')}</span>
			<h1 class="mm-ab-h1">{t('about.hello')}<br /><span class="mm-red">{t('about.name')}</span></h1>
			<p class="mm-ab-p" set:html={t('about.introp1')}></p>
			<p class="mm-ab-p" set:html={t('about.introp2')}></p>
		</div>
	</section>

	<!-- STATS -->
	<div class="mm-stats">
		<div class="mm-stat"><div class="mm-stat-num">+6</div><div class="mm-stat-lbl">{t('home.statyears')}</div></div>
		<div class="mm-stat"><div class="mm-stat-num">10+</div><div class="mm-stat-lbl">{t('home.stattalks')}</div></div>
		<div class="mm-stat mm-stat--news"><div class="mm-stat-news">GENAI</div><div class="mm-stat-lbl mm-stat-lbl--news">GOOGLE · HUGGING FACE</div></div>
	</div>

	<!-- EN QUÉ TRABAJO -->
	<section class="mm-work">
		<div class="mm-sec-head"><h2 class="mm-sec-tag">{t('about.worktag')}</h2></div>
		<div class="mm-work-grid">
			<div class="mm-work-cell"><h3 class="mm-work-title">{t('about.work1t')}</h3><p class="mm-work-desc">{t('about.work1d')}</p></div>
			<div class="mm-work-cell"><h3 class="mm-work-title">{t('about.work2t')}</h3><p class="mm-work-desc">{t('about.work2d')}</p></div>
			<div class="mm-work-cell"><h3 class="mm-work-title">{t('about.work3t')}</h3><p class="mm-work-desc">{t('about.work3d')}</p></div>
			<div class="mm-work-cell"><h3 class="mm-work-title">{t('about.work4t')}</h3><p class="mm-work-desc">{t('about.work4d')}</p></div>
		</div>
	</section>

	<!-- HISTORIA (contenido propio) -->
	<section class="mm-story">
		<div class="mm-sec-head"><h2 class="mm-sec-tag">{t('about.storytag')}</h2></div>
		<slot />
	</section>

	<!-- MODELO DESTACADO: ES DRAC -->
	<section class="mm-esdrac">
		<div class="mm-sec-head"><h2 class="mm-sec-tag">{t('about.esdractag')}</h2></div>
		<a class="mm-esdrac-imgwrap" href="https://huggingface.co/natzx94/EsDrac-v1-7B" target="_blank" rel="noopener noreferrer">
			<img class="mm-esdrac-img" src="/esdrac.jpg" alt="EsDrac — modelo de lenguaje en mallorquí" loading="lazy" />
		</a>
		<div class="mm-esdrac-body">
			<div class="mm-esdrac-head">
				<h3 class="mm-esdrac-name">EsDrac-v1-7B</h3>
				<span class="mm-esdrac-chip">HUGGING&nbsp;FACE</span>
			</div>
			<p class="mm-esdrac-desc" set:html={t('about.esdracdesc')}></p>
			<p class="mm-esdrac-meta">MALLORQUÍ · QWEN2.5-7B · APACHE-2.0 · 583&nbsp;↓</p>
			<div class="mm-esdrac-links">
				<a href="https://huggingface.co/natzx94/EsDrac-v1-7B" target="_blank" rel="noopener noreferrer" class="mm-esdrac-link mm-esdrac-link--main">MODELO ↗</a>
				<a href="https://huggingface.co/natzx94/EsDrac-v1-7B-GGUF" target="_blank" rel="noopener noreferrer" class="mm-esdrac-link">GGUF ↗</a>
				<a href="https://huggingface.co/datasets/natzx94/EsDrac-mallorqui" target="_blank" rel="noopener noreferrer" class="mm-esdrac-link">DATASET ↗</a>
			</div>
			<a class="mm-esdrac-profile" href="https://huggingface.co/natzx94" target="_blank" rel="noopener noreferrer">{t('about.esdracprofile')}</a>
		</div>
	</section>

	<!-- PROYECTO: BALÙA (visión + comida) -->
	<section class="mm-balua">
		<div class="mm-sec-head"><h2 class="mm-sec-tag">{t('about.baluatag')}</h2></div>
		<div class="mm-esdrac-body mm-balua-body">
			<div class="mm-esdrac-head">
				<h3 class="mm-esdrac-name">Balùa</h3>
				<span class="mm-esdrac-chip">HUGGING&nbsp;FACE</span>
			</div>
			<p class="mm-esdrac-desc" set:html={t('about.baluadesc')}></p>
			<p class="mm-esdrac-meta">VISIÓN · QWEN2.5-VL-3B · NUTRITION5K · APACHE-2.0</p>
			<div class="mm-esdrac-links">
				<a href="https://huggingface.co/natzx94/balua-qwen25vl-3b-food-lora" target="_blank" rel="noopener noreferrer" class="mm-esdrac-link mm-esdrac-link--main">MODELO ↗</a>
				<a href="https://huggingface.co/natzx94/balua-qwen3b-food-gguf" target="_blank" rel="noopener noreferrer" class="mm-esdrac-link">GGUF ↗</a>
				<a href="https://huggingface.co/datasets/natzx94/balua-food-es" target="_blank" rel="noopener noreferrer" class="mm-esdrac-link">DATASET ↗</a>
			</div>
		</div>
	</section>

	<!-- MIS PROYECTOS -->
	<section class="mm-projects">
		<div class="mm-sec-head"><h2 class="mm-sec-tag">{t('about.projectstag')}</h2></div>
		<div class="mm-proj-grid">
			{projectList.map((p) => (
				<article class="mm-proj-card">
					<div class="mm-proj-top">
						<h3 class="mm-proj-name">{p.name}</h3>
						<span class="mm-proj-chip">{p.tag}</span>
					</div>
					<p class="mm-proj-desc">{p.desc}</p>
					<div class="mm-proj-links">
						<a href={p.repo} target="_blank" rel="noopener noreferrer" class="mm-proj-link">GITHUB ↗</a>
						{p.demo && (
							<a href={p.demo} target="_blank" rel="noopener noreferrer" class="mm-proj-link mm-proj-link--demo">{t('about.projectsdemo')} ↗</a>
						)}
					</div>
				</article>
			))}
		</div>
	</section>

	<!-- CONTACTO -->
	<section id="contacto" class="mm-contact">
		<h2 class="mm-contact-title" set:html={t('about.ctatitle')}></h2>
		<div class="mm-contact-btns">
			<a href={`/contacto/${lang}/`} class="mm-cbtn mm-cbtn--red">{t('nav.contact')}</a>
			<a href="https://www.linkedin.com/in/marc-mayol-orell/" target="_blank" rel="noopener noreferrer" class="mm-cbtn">LINKEDIN</a>
			<a href="https://github.com/marcmayol" target="_blank" rel="noopener noreferrer" class="mm-cbtn">GITHUB</a>
		</div>
	</section>

</div>

<style>
	/* HERO */
	.mm-ab-hero{display:grid;grid-template-columns:minmax(0,1fr) 1.3fr;border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-ab-photo{position:relative;min-height:460px;background:var(--mm-ink);border-right:var(--mm-border) solid var(--mm-ink)}
	.mm-ab-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
	.mm-ab-copy{padding:var(--space-2xl) var(--mm-pad-x);min-width:0}
	.mm-ab-h1{
		font-size:var(--text-4xl);line-height:.96;font-weight:900;letter-spacing:-.03em;
		margin:0 0 var(--space-md);text-transform:uppercase;overflow-wrap:anywhere;
	}
	.mm-ab-p{font-family:var(--mm-font-mono);font-size:var(--text-base);line-height:1.7;color:var(--mm-body);max-width:520px;margin:0 0 var(--space-sm)}
	.mm-ab-p:last-child{margin-bottom:0}

	/* WORK GRID */
	.mm-work{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-work-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:var(--mm-border) solid var(--mm-ink)}
	.mm-work-cell{padding:var(--space-md);border-right:var(--mm-border) solid var(--mm-ink);border-bottom:var(--mm-border) solid var(--mm-ink);min-width:0}
	.mm-work-cell:nth-child(2n){border-right:none}
	.mm-work-cell:nth-last-child(-n+2){border-bottom:none}
	.mm-work-title{font-weight:800;font-size:1.125rem;margin:0 0 var(--space-2xs);text-transform:uppercase;overflow-wrap:anywhere}
	.mm-work-desc{font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-body-2);line-height:1.6;margin:0}

	/* STORY (contenido propio) */
	.mm-story{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink)}

	/* MODELO DESTACADO: ES DRAC */
	.mm-esdrac{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-esdrac-imgwrap{display:block;border:var(--mm-border) solid var(--mm-ink);line-height:0}
	.mm-esdrac-img{width:100%;height:auto;display:block}
	.mm-esdrac-body{border:var(--mm-border) solid var(--mm-ink);border-top:none;padding:var(--space-md);background:var(--mm-paper-2)}
	.mm-esdrac-head{display:flex;justify-content:space-between;align-items:baseline;gap:var(--space-xs);margin-bottom:var(--space-xs);flex-wrap:wrap}
	.mm-esdrac-name{font-weight:800;font-size:var(--text-xl);margin:0;text-transform:uppercase;line-height:1.05;overflow-wrap:anywhere}
	.mm-esdrac-chip{font-family:var(--mm-font-mono);font-size:var(--text-2xs);font-weight:700;background:var(--mm-accent);color:var(--mm-on-ink);padding:var(--space-3xs) var(--space-2xs);white-space:nowrap}
	.mm-esdrac-desc{font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-body);line-height:1.7;margin:0 0 var(--space-sm)}
	.mm-esdrac-meta{font-family:var(--mm-font-mono);font-size:var(--text-2xs);color:var(--mm-muted);font-weight:700;margin:0 0 var(--space-md)}
	.mm-esdrac-links{display:flex;flex-wrap:wrap;gap:0;font-family:var(--mm-font-mono);font-size:var(--text-xs);font-weight:700}
	.mm-esdrac-link{
		text-decoration:none;color:var(--mm-ink);padding:var(--space-xs) var(--space-sm);
		border:var(--mm-border) solid var(--mm-ink);border-right:none;
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-esdrac-link:last-child{border-right:var(--mm-border) solid var(--mm-ink)}
	.mm-esdrac-link:hover{background:var(--mm-ink);color:var(--mm-on-ink)}
	.mm-esdrac-link--main{background:var(--mm-ink);color:var(--mm-on-ink)}
	.mm-esdrac-link--main:hover{background:var(--mm-accent);border-color:var(--mm-accent)}
	.mm-esdrac-profile{
		display:inline-block;margin-top:var(--space-sm);font-family:var(--mm-font-mono);font-size:var(--text-xs);
		font-weight:700;color:var(--mm-accent-ink);text-decoration:none;
	}
	.mm-esdrac-profile:hover{text-decoration:underline}

	/* BALÙA */
	.mm-balua{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-balua-body{border-top:var(--mm-border) solid var(--mm-ink)}

	/* MIS PROYECTOS */
	.mm-projects{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-proj-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));border:var(--mm-border) solid var(--mm-ink)}
	.mm-proj-card{
		padding:var(--space-md);border-right:var(--mm-border) solid var(--mm-ink);border-bottom:var(--mm-border) solid var(--mm-ink);
		display:flex;flex-direction:column;min-width:0;background:var(--mm-paper);
		transition:background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-proj-card:hover{background:var(--mm-paper-2)}
	.mm-proj-card:nth-child(2n){border-right:none}
	.mm-proj-card:last-child:nth-child(odd){border-right:none}
	.mm-proj-card:nth-last-child(-n+1):nth-child(odd){border-bottom:none}
	.mm-proj-top{display:flex;justify-content:space-between;align-items:baseline;gap:var(--space-xs);margin-bottom:var(--space-xs);flex-wrap:wrap}
	.mm-proj-name{font-weight:800;font-size:var(--text-lg);margin:0;text-transform:uppercase;line-height:1.05;overflow-wrap:anywhere}
	.mm-proj-chip{font-family:var(--mm-font-mono);font-size:var(--text-2xs);font-weight:700;background:var(--mm-ink);color:var(--mm-on-ink);padding:var(--space-3xs) var(--space-2xs);white-space:nowrap}
	.mm-proj-desc{font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-body-2);line-height:1.65;margin:0 0 var(--space-sm);flex:1}
	.mm-proj-links{display:flex;flex-wrap:wrap;gap:0;font-family:var(--mm-font-mono);font-size:var(--text-xs);font-weight:700}
	.mm-proj-link{
		text-decoration:none;color:var(--mm-ink);padding:var(--space-2xs) var(--space-sm);
		border:var(--mm-border) solid var(--mm-ink);border-right:none;
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-proj-link:last-child{border-right:var(--mm-border) solid var(--mm-ink)}
	.mm-proj-link:hover{background:var(--mm-ink);color:var(--mm-on-ink)}
	.mm-proj-link--demo{background:var(--mm-accent);color:var(--mm-on-ink);border-color:var(--mm-accent)}
	.mm-proj-link--demo:hover{background:var(--mm-ink);border-color:var(--mm-ink)}

	@media (max-width:860px){
		.mm-ab-hero{grid-template-columns:1fr}
		.mm-ab-photo{border-right:none;border-bottom:var(--mm-border) solid var(--mm-ink);min-height:320px}
		.mm-ab-copy{padding:var(--space-xl) var(--mm-pad-x)}
		.mm-ab-h1{font-size:var(--text-3xl)}
		.mm-work,.mm-story,.mm-projects,.mm-esdrac,.mm-balua{padding:var(--space-xl) var(--mm-pad-x)}
		.mm-esdrac-name{font-size:var(--text-lg)}
		.mm-work-grid{grid-template-columns:1fr}
		.mm-work-cell{border-right:none}
		.mm-work-cell:nth-last-child(-n+2){border-bottom:var(--mm-border) solid var(--mm-ink)}
		.mm-work-cell:last-child{border-bottom:none}
		.mm-proj-grid{grid-template-columns:1fr}
		.mm-proj-card{border-right:none;border-bottom:var(--mm-border) solid var(--mm-ink)}
		.mm-proj-card:last-child{border-bottom:none}
	}
	@media (max-width:640px){
		/* stats: 2 columnas, la celda GENAI ocupa la fila entera abajo */
		.mm-stats{display:grid;grid-template-columns:repeat(2,minmax(0,1fr))}
		.mm-stat{border-right:var(--mm-border) solid var(--mm-ink);border-bottom:var(--mm-border) solid var(--mm-ink)}
		.mm-stat:nth-child(2n){border-right:none}
		.mm-stat--news{grid-column:1/-1;border-right:none;border-bottom:none}
	}
</style>

<!-- Contenido inyectado con set:html y el slot de la historia: sin scope de Astro,
     así que estas reglas tienen que ser globales o no aplican. -->
<style is:global>
	.mm-about .mm-ab-p strong,
	.mm-about .mm-esdrac-desc strong{color:var(--mm-accent-ink)}

	.mm-about .mm-story-block{
		display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:var(--space-lg);align-items:center;
		padding:var(--space-lg) 0;border-top:var(--mm-hair) solid var(--mm-rule);
	}
	.mm-about .mm-story-block:first-of-type{border-top:none;padding-top:var(--space-md)}
	.mm-about .mm-story-block--rev .mm-story-media{order:2}
	.mm-about .mm-story-media img{width:100%;height:auto;display:block;border:var(--mm-border) solid var(--mm-ink)}
	.mm-about .mm-story-media figcaption{font-family:var(--mm-font-mono);font-size:var(--text-2xs);color:var(--mm-muted);margin-top:var(--space-2xs)}
	.mm-about .mm-story-h{font-weight:800;font-size:var(--text-xl);margin:0 0 var(--space-xs);text-transform:uppercase;line-height:1.05;overflow-wrap:anywhere}
	.mm-about .mm-story-t{font-family:var(--mm-font-mono);font-size:var(--text-sm);line-height:1.75;color:var(--mm-body);margin:0}
	.mm-about .mm-story-t strong{color:var(--mm-ink)}
	.mm-about .mm-story-link{color:var(--mm-accent-ink);font-weight:700;text-decoration:none;border-bottom:var(--mm-border) solid var(--mm-accent-ink)}
	.mm-about .mm-story-link:hover{background:var(--mm-accent);color:var(--mm-on-ink)}
	@media (max-width:860px){
		.mm-about .mm-story-block{grid-template-columns:1fr;gap:var(--space-md);padding:var(--space-md) 0}
		.mm-about .mm-story-block--rev .mm-story-media{order:0}
	}
</style>
