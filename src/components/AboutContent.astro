---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { projects } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const projectList = projects[lang] ?? projects.es;
---

<div class="mm-about">

	<!-- Hero dividido: texto sobre el fondo, retrato a la derecha fundido con él -->
	<section class="mm-hero">
		<div class="mm-hero-txt">
			<h1 class="mm-h1">{t('about.hello')} <span class="mm-acc">{t('about.name')}</span></h1>
			<p class="mm-lede" set:html={t('about.introp1')}></p>
			<p class="mm-lede" set:html={t('about.introp2')}></p>
			<a href={`/contacto/${lang}/`} class="mm-cta">{t('home.cta')}</a>
		</div>
		<figure class="mm-photo">
			<img src="/perfil-1080.webp" srcset="/perfil-720.webp 720w, /perfil-1080.webp 1080w" sizes="(max-width: 860px) 100vw, 50vw" alt={t('home.photoalt')} width="1080" height="1440" fetchpriority="high" />
		</figure>
	</section>

	<!-- En qué trabajo -->
	<section class="mm-band">
		<h2 class="mm-h2">{t('about.worktag')}</h2>
		<ul class="mm-work">
			{[1, 2, 3, 4].map((n) => (
				<li>
					<h3 class="mm-work-t">{t(`about.work${n}t` as 'about.work1t')}</h3>
					<p class="mm-work-d">{t(`about.work${n}d` as 'about.work1d')}</p>
				</li>
			))}
		</ul>
	</section>

	<!-- Historia (contenido propio de cada idioma) -->
	<section class="mm-band">
		<h2 class="mm-h2">{t('about.storytag')}</h2>
		<slot />
	</section>

	<!-- Modelo destacado: EsDrac -->
	<section class="mm-band">
		<h2 class="mm-h2">{t('about.esdractag')}</h2>
		<a class="mm-model-img" href="https://huggingface.co/natzx94/EsDrac-v1-7B" target="_blank" rel="noopener noreferrer">
			<img src="/esdrac.webp" alt="EsDrac — modelo de lenguaje en mallorquí" loading="lazy" />
		</a>
		<div class="mm-model">
			<h3 class="mm-model-n">EsDrac-v1-7B</h3>
			<p class="mm-model-m">mallorquí · Qwen2.5-7B · Apache-2.0</p>
			<p class="mm-model-d" set:html={t('about.esdracdesc')}></p>
			<ul class="mm-links">
				<li><a href="https://huggingface.co/natzx94/EsDrac-v1-7B" target="_blank" rel="noopener noreferrer">{t('about.model')} ↗</a></li>
				<li><a href="https://huggingface.co/natzx94/EsDrac-v1-7B-GGUF" target="_blank" rel="noopener noreferrer">GGUF ↗</a></li>
				<li><a href="https://huggingface.co/datasets/natzx94/EsDrac-mallorqui" target="_blank" rel="noopener noreferrer">Dataset ↗</a></li>
				<li><a href="https://huggingface.co/natzx94" target="_blank" rel="noopener noreferrer">{t('about.esdracprofile')}</a></li>
			</ul>
		</div>
	</section>

	<!-- Proyecto: Balùa (visión + comida) -->
	<section class="mm-band">
		<h2 class="mm-h2">{t('about.baluatag')}</h2>
		<div class="mm-model">
			<h3 class="mm-model-n">Balùa</h3>
			<p class="mm-model-m">Qwen2.5-VL-3B · Nutrition5k · Apache-2.0</p>
			<p class="mm-model-d" set:html={t('about.baluadesc')}></p>
			<ul class="mm-links">
				<li><a href="https://huggingface.co/natzx94/balua-qwen25vl-3b-food-lora" target="_blank" rel="noopener noreferrer">{t('about.model')} ↗</a></li>
				<li><a href="https://huggingface.co/natzx94/balua-qwen3b-food-gguf" target="_blank" rel="noopener noreferrer">GGUF ↗</a></li>
				<li><a href="https://huggingface.co/datasets/natzx94/balua-food-es" target="_blank" rel="noopener noreferrer">Dataset ↗</a></li>
			</ul>
		</div>
	</section>

	<!-- Mis proyectos -->
	<section class="mm-band">
		<h2 class="mm-h2">{t('about.projectstag')}</h2>
		<ul class="mm-grid">
			{projectList.map((p) => (
				<li class="mm-it">
					<span class="mm-it-k">{p.tag}</span>
					<h3 class="mm-it-n">{p.name}</h3>
					<p class="mm-it-d">{p.desc}</p>
					<ul class="mm-links">
						<li><a href={p.repo} target="_blank" rel="noopener noreferrer">GitHub ↗</a></li>
						{p.demo && <li><a href={p.demo} target="_blank" rel="noopener noreferrer">{t('about.projectsdemo')} ↗</a></li>}
					</ul>
				</li>
			))}
		</ul>
	</section>

</div>

<style>
	/* Hallmark · genre: atmospheric · macrostructure: Photographic (split) · design-system: design.md · designed-as-app */
	.mm-about{background:var(--mm-paper);color:var(--mm-ink);font-family:var(--mm-font-body)}
	ul{list-style:none;margin:0;padding:0}

	/* HERO · sube por detrás de la píldora de navegación, como en la portada */
	.mm-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(0,1fr);min-height:88vh;margin-top:calc(var(--mm-nav-h) * -1)}
	.mm-hero-txt{
		padding:calc(var(--mm-nav-h) + clamp(3.5rem,9vw,8rem)) var(--mm-pad-x) clamp(3rem,8vw,6rem);
		display:flex;flex-direction:column;justify-content:flex-end;min-width:0;
	}
	.mm-h1{font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-hero);line-height:.98;letter-spacing:-.04em;margin:0 0 var(--space-md);text-wrap:balance;min-width:0}
	.mm-acc{color:var(--mm-accent-ink)}
	.mm-lede{font-size:var(--text-lede);line-height:1.55;font-weight:300;color:var(--mm-ink-soft);max-width:44ch;margin:0 0 var(--space-sm)}
	.mm-lede:last-of-type{margin-bottom:var(--space-lg)}
	.mm-cta{
		align-self:flex-start;display:inline-flex;align-items:center;min-height:48px;padding:0 22px;
		border-radius:var(--mm-radius-pill);background:var(--mm-accent);color:var(--mm-on-ink);
		font-weight:600;font-size:var(--text-base);text-decoration:none;
		transition:background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-cta:hover{background:var(--mm-ink)}
	.mm-photo{position:relative;margin:0;min-height:420px;overflow:hidden}
	.mm-photo img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:50% 25%}
	.mm-photo::after{
		content:"";position:absolute;inset:0;pointer-events:none;
		background:
			linear-gradient(90deg,var(--mm-paper) 0%,oklch(15% 0.008 260 / 0) 35%),
			linear-gradient(180deg,oklch(15% 0.008 260 / 0.55) 0%,oklch(15% 0.008 260 / 0) 22%);
	}

	/* BANDAS · título encima, una columna */
	.mm-band{max-width:var(--mm-maxw);margin:0 auto;padding:var(--space-3xl) var(--mm-pad-x);border-top:var(--mm-hair) solid var(--mm-rule);box-sizing:border-box}
	.mm-h2{font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-h2);line-height:1.05;letter-spacing:-.03em;margin:0 0 var(--space-lg);max-width:24ch;text-wrap:balance}

	/* Trabajo */
	.mm-work{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));column-gap:var(--space-2xl);max-width:960px}
	.mm-work li{padding:var(--space-md) 0;border-top:var(--mm-hair) solid var(--mm-rule)}
	.mm-work-t{font-size:var(--text-lg);font-weight:500;letter-spacing:-.01em;margin:0 0 var(--space-2xs)}
	.mm-work-d{font-size:var(--text-md);line-height:1.55;font-weight:300;color:var(--mm-ink-soft);margin:0;max-width:46ch}

	/* Modelos publicados */
	.mm-model-img{display:block;max-width:960px;margin-bottom:var(--space-lg);line-height:0}
	.mm-model-img img{width:100%;height:auto;border-radius:var(--mm-radius-sm)}
	.mm-model{max-width:68ch}
	.mm-model-n{font-size:var(--text-xl);font-weight:500;letter-spacing:-.02em;margin:0 0 var(--space-2xs)}
	.mm-model-m{font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-muted);margin:0 0 var(--space-md)}
	.mm-model-d{font-size:var(--text-md);line-height:1.65;font-weight:300;color:var(--mm-ink-soft);margin:0 0 var(--space-md)}

	/* Enlaces de texto en mono, 44 px de alto */
	.mm-links{display:flex;flex-wrap:wrap;column-gap:var(--space-md)}
	.mm-links a{
		display:inline-flex;align-items:center;min-height:44px;
		font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-accent-ink);text-decoration:none;
	}
	.mm-links a:hover{text-decoration:underline;text-underline-offset:4px}

	/* Proyectos · celdas separadas por filetes de 1 px */
	.mm-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1px;background:var(--mm-rule);border:var(--mm-hair) solid var(--mm-rule)}
	.mm-it{display:flex;flex-direction:column;padding:var(--space-lg) var(--space-md) var(--space-sm);background:var(--mm-paper);min-width:0}
	.mm-it-k{display:block;font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-muted);text-transform:lowercase;margin-bottom:var(--space-xs)}
	.mm-it-n{font-size:var(--text-xl);font-weight:500;letter-spacing:-.02em;margin:0 0 var(--space-2xs)}
	.mm-it-d{font-size:var(--text-base);line-height:1.6;font-weight:300;color:var(--mm-ink-soft);margin:0 0 var(--space-sm);flex:1}

	@media (max-width:860px){
		.mm-hero{grid-template-columns:minmax(0,1fr);min-height:0}
		.mm-photo{order:-1;min-height:440px}
		.mm-photo::after{background:linear-gradient(180deg,oklch(15% 0.008 260 / 0.65) 0%,oklch(15% 0.008 260 / 0) 32%,oklch(15% 0.008 260 / 0) 55%,var(--mm-paper) 100%)}
		.mm-hero-txt{padding:var(--space-md) var(--mm-pad-x) var(--space-2xl)}
		.mm-band{padding:var(--space-2xl) var(--mm-pad-x)}
		.mm-work,.mm-grid{grid-template-columns:minmax(0,1fr)}
	}
	@media (prefers-reduced-motion:reduce){.mm-cta{transition:none}}
</style>

<!-- Contenido inyectado con set:html y el slot de la historia: sin scope de Astro,
     así que estas reglas tienen que ser globales o no aplican. -->
<style is:global>
	.mm-about .mm-lede strong,
	.mm-about .mm-model-d strong{color:var(--mm-ink);font-weight:500}

	.mm-about .mm-story-block{
		display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:var(--space-2xl);align-items:start;
		padding:var(--space-xl) 0;border-top:var(--mm-hair) solid var(--mm-rule);
	}
	.mm-about .mm-story-block:first-of-type{border-top:none;padding-top:0}
	.mm-about .mm-story-block--rev .mm-story-media{order:2}
	.mm-about .mm-story-media figure{margin:0}
	.mm-about .mm-story-media img{width:100%;height:auto;display:block;border-radius:var(--mm-radius-sm)}
	.mm-about .mm-story-media figcaption{font-family:var(--mm-font-mono);font-size:var(--text-xs);line-height:1.5;color:var(--mm-muted);margin-top:var(--space-2xs)}
	.mm-about .mm-story-h{font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-xl);letter-spacing:-.02em;line-height:1.15;margin:0 0 var(--space-sm)}
	.mm-about .mm-story-t{font-size:var(--text-md);line-height:1.7;font-weight:300;color:var(--mm-ink-soft);margin:0;max-width:64ch}
	.mm-about .mm-story-t strong{color:var(--mm-ink);font-weight:500}
	.mm-about .mm-story-link{color:var(--mm-accent-ink);text-decoration:underline;text-decoration-thickness:1px;text-underline-offset:3px}
	.mm-about .mm-story-link:hover{color:var(--mm-accent-hi)}
	@media (max-width:860px){
		.mm-about .mm-story-block{grid-template-columns:minmax(0,1fr);gap:var(--space-md);padding:var(--space-lg) 0}
		.mm-about .mm-story-block--rev .mm-story-media{order:0}
	}
</style>
