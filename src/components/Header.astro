---
import { changeroutelang, getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
	customURL?: string;
}
const { customURL } = Astro.props as Props;
// Portada canónica de cada idioma (/es/ es una copia de /)
const home = lang === 'es' ? '/' : '/en/';
const path = Astro.url.pathname;
const isCurrent = (seg: string) => path.includes(seg);
---

<!-- Hallmark · nav: N7 Brutal slab · design-system: design.md -->
<header class="mm-header">
	<a href={home} class="mm-logo">Marc Mayol</a>
	<nav class="mm-nav" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
		<a href={`/about/${lang}/`} class="mm-navlink" aria-current={isCurrent('/about') ? 'page' : undefined}>{t('nav.about')}</a>
		<a href={`${home}#proyectos`} class="mm-navlink">{t('nav.projects')}</a>
		<a href={`${home}#charlas`} class="mm-navlink">{t('nav.talks')}</a>
		<a href={`/blog/${lang}/`} class="mm-navlink" aria-current={isCurrent('/blog') ? 'page' : undefined}>{t('nav.blog')}</a>
		<span class="mm-lang">
			{Object.entries(languages).map(([code, label]) => (
				code === lang ? (
					<span class="mm-lang-btn" data-active="1" aria-current="true">{code.toUpperCase()}</span>
				) : (
					<a class="mm-lang-btn" href={changeroutelang(Astro.url, code, customURL)} hreflang={code} title={label}>{code.toUpperCase()}</a>
				)
			))}
		</span>
		<a href={`/contacto/${lang}/`} class="mm-navlink mm-navlink--cta" aria-current={isCurrent('/contacto') ? 'page' : undefined}>{t('nav.contact')}</a>
	</nav>
</header>

<style>
	.mm-header{
		position:sticky;top:0;z-index:50;
		max-width:var(--mm-maxw);margin:0 auto;
		border-left:var(--mm-border) solid var(--mm-ink);border-right:var(--mm-border) solid var(--mm-ink);
		display:flex;align-items:stretch;justify-content:space-between;flex-wrap:wrap;
		background:var(--mm-paper);color:var(--mm-ink);
		border-bottom:var(--mm-border-heavy) solid var(--mm-ink);
	}
	.mm-logo{
		font-family:var(--mm-font-display);font-weight:900;font-size:var(--text-lg);letter-spacing:-0.02em;
		text-decoration:none;color:var(--mm-ink);white-space:nowrap;
		display:flex;align-items:center;padding:var(--space-sm) var(--space-md);
		border-right:var(--mm-border-heavy) solid var(--mm-ink);
	}
	.mm-nav{display:flex;align-items:stretch;flex-wrap:wrap}
	.mm-navlink{
		font-family:var(--mm-font-mono);font-size:var(--text-xs);font-weight:700;
		text-transform:uppercase;letter-spacing:.04em;white-space:nowrap;
		text-decoration:none;color:var(--mm-ink);
		display:flex;align-items:center;min-height:52px;padding:0 var(--space-md);
		border-left:var(--mm-hair) solid var(--mm-rule);
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-navlink:hover{background:var(--mm-paper-2)}
	.mm-navlink[aria-current="page"]{text-decoration:underline;text-decoration-color:var(--mm-accent);text-decoration-thickness:3px;text-underline-offset:6px}
	.mm-navlink--cta{background:var(--mm-ink);color:var(--mm-on-ink);border-left:var(--mm-border-heavy) solid var(--mm-ink)}
	.mm-navlink--cta:hover{background:var(--mm-accent)}
	.mm-header :focus-visible{outline-offset:-3px}
	.mm-lang{
		display:flex;align-items:center;gap:var(--space-2xs);padding:0 var(--space-sm);
		font-family:var(--mm-font-mono);font-size:var(--text-xs);
		border-left:var(--mm-hair) solid var(--mm-rule);
	}
	.mm-lang-btn{color:var(--mm-ink);text-decoration:none;display:inline-flex;align-items:center;justify-content:center;min-width:32px;min-height:32px}
	.mm-lang-btn:hover{text-decoration:underline}
	.mm-lang-btn[data-active="1"]{font-weight:700;text-decoration:underline;text-decoration-color:var(--mm-accent);text-decoration-thickness:2px;text-underline-offset:4px}
	@media (max-width:860px){
		/* El apilado es demasiado alto para dejarlo fijo: en móvil se queda quieto. */
		.mm-header{position:static}
		.mm-logo{flex:1 1 100%;border-right:none;border-bottom:var(--mm-hair) solid var(--mm-rule);min-height:44px}
		.mm-nav{flex:1 1 100%}
		.mm-navlink{flex:1 1 auto;justify-content:center;min-height:44px;padding:0 var(--space-xs)}
		.mm-lang{padding:0 var(--space-2xs)}
		.mm-lang-btn{min-width:44px;min-height:44px}
	}
</style>
