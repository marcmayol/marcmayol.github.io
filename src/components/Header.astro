---
import { changeroutelang, getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
	customURL?: string;
}
const { customURL } = Astro.props as Props;
// Portada canónica de cada idioma (/es/ es una copia de /)
const home = lang === 'es' ? '/' : '/en/';
const path = Astro.url.pathname;
const isCurrent = (seg: string) => path.includes(seg);
const other = Object.entries(languages).find(([code]) => code !== lang);
---

<!-- Hallmark · nav: N5 Floating pill (fija, cambia al bajar) · design-system: design.md -->
<div class="mm-navw">
	<header class="mm-nav" data-mm-nav>
		<a href={home} class="mm-wm">marc mayol</a>
		<nav class="mm-links" aria-label={lang === 'es' ? 'Principal' : 'Main'}>
			<a href={`${home}#proyectos`}>{t('nav.projects')}</a>
			<a href={`${home}#charlas`}>{t('nav.talks')}</a>
			<a href={`/blog/${lang}/`} aria-current={isCurrent('/blog') ? 'page' : undefined}>{t('nav.blog')}</a>
			<a href={`/about/${lang}/`} aria-current={isCurrent('/about') ? 'page' : undefined}>{t('nav.about')}</a>
			{other && <a href={changeroutelang(Astro.url, other[0], customURL)} hreflang={other[0]} title={other[1]}>{other[0]}</a>}
			<a href={`/contacto/${lang}/`} class="mm-links-cta" aria-current={isCurrent('/contacto') ? 'page' : undefined}>{t('nav.contact')}</a>
		</nav>
	</header>
</div>

<script is:inline>
	// La píldora pasa de transparente a negra en cuanto se deja la parte de arriba.
	(() => {
		const nav = document.querySelector('[data-mm-nav]');
		if (!nav) return;
		const update = () => nav.classList.toggle('is-on', window.scrollY > 24);
		update();
		window.addEventListener('scroll', update, { passive: true });
	})();
</script>

<style>
	.mm-navw{
		position:sticky;top:0;z-index:50;height:var(--mm-nav-h);
		display:flex;align-items:center;justify-content:center;
		padding:0 clamp(0.75rem,3vw,2.5rem);
	}
	.mm-nav{
		display:flex;align-items:center;justify-content:space-between;gap:var(--space-sm);
		width:100%;max-width:1120px;padding:6px 6px 6px 22px;
		border:1px solid transparent;border-radius:var(--mm-radius-pill);
		font-family:var(--mm-font-mono);font-size:var(--text-sm);
		background:transparent;
		transition:background var(--mm-dur-2) var(--mm-ease-out),border-color var(--mm-dur-2) var(--mm-ease-out),max-width var(--mm-dur-2) var(--mm-ease-out);
	}
	.mm-nav.is-on{background:var(--mm-bar);border-color:var(--mm-rule);max-width:880px}
	.mm-nav a{color:var(--mm-ink);text-decoration:none;text-shadow:0 1px 8px oklch(0% 0 0 / 0.5)}
	.mm-nav.is-on a{text-shadow:none}
	.mm-wm{font-weight:500;white-space:nowrap}
	.mm-links{display:flex;align-items:center;flex-wrap:wrap;gap:2px}
	.mm-links a{
		display:inline-flex;align-items:center;min-height:40px;padding:0 14px;
		border-radius:var(--mm-radius-pill);white-space:nowrap;text-transform:lowercase;
		transition:background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-links a:hover{background:var(--mm-paper-2)}
	.mm-links a[aria-current="page"]{color:var(--mm-accent-ink)}
	.mm-links .mm-links-cta{background:var(--mm-accent);color:var(--mm-on-ink);text-shadow:none;font-weight:500}
	.mm-links .mm-links-cta:hover{background:var(--mm-ink)}
	.mm-links .mm-links-cta[aria-current="page"]{color:var(--mm-on-ink)}
	@media (max-width:860px){
		.mm-nav{flex-direction:column;align-items:stretch;gap:6px;border-radius:24px;padding:10px}
		.mm-wm{padding:6px 12px}
		.mm-links a{min-height:44px;padding:0 12px}
	}
	@media (prefers-reduced-motion:reduce){.mm-nav,.mm-links a{transition:none}}
</style>
