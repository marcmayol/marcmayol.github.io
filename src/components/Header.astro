---
import { changeroutelang, getLangFromUrl, useTranslations } from '../i18n/utils';
import { languages } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

interface Props {
	customURL?: string;
}
const { customURL } = Astro.props as Props;
---

<header class="mm-header">
	<a href={`/${lang}`} class="mm-logo">MARC_MAYOL<span class="mm-red">.COM</span></a>
	<nav class="mm-nav" aria-label="Main Navigation">
		<a href={`/about/${lang}/`} class="mm-navlink" title={t('nav.about')}>{t('nav.about')}</a>
		<a href={`/${lang}#servicios`} class="mm-navlink" title={t('nav.services')}>{t('nav.services')}</a>
		<a href={`/blog/${lang}/`} class="mm-navlink" title={t('nav.blog')}>{t('nav.blog')}</a>
		<a href={`/contacto/${lang}/`} class="mm-navlink mm-navlink--cta" title={t('nav.contact')}>{t('nav.contact')}</a>
		<span class="mm-lang">
			{Object.entries(languages).map(([code, label]) => (
				code === lang ? (
					<span class="mm-lang-btn" data-active="1" aria-current="true">{code.toUpperCase()}</span>
				) : (
					<a class="mm-lang-btn" href={changeroutelang(Astro.url, code, customURL)} title={`Cambiar a ${label}`}>{code.toUpperCase()}</a>
				)
			))}
		</span>
	</nav>
</header>

<style>
	.mm-header{
		max-width:var(--mm-maxw);margin:0 auto;
		display:flex;justify-content:space-between;align-items:center;gap:var(--space-xs);
		padding:var(--space-sm) var(--space-lg);
		background:var(--mm-paper-2);color:var(--mm-ink);
		border-bottom:var(--mm-border) solid var(--mm-ink);
		border-left:var(--mm-border) solid var(--mm-ink);
		border-right:var(--mm-border) solid var(--mm-ink);
		position:sticky;top:0;z-index:50;
		font-family:var(--mm-font-mono);
	}
	.mm-logo{
		text-decoration:none;font-weight:700;font-size:var(--text-base);letter-spacing:.02em;color:var(--mm-ink);
	}
	.mm-nav{display:flex;align-items:center;gap:0;font-size:var(--text-xs)}
	.mm-navlink{
		text-decoration:none;padding:var(--space-3xs) var(--space-sm);color:var(--mm-ink);
		border-left:var(--mm-hair) solid var(--mm-rule-soft);
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
		text-transform:uppercase;white-space:nowrap;
	}
	.mm-navlink:hover{background:var(--mm-paper)}
	.mm-navlink--cta{background:var(--mm-accent);color:var(--mm-on-ink)}
	.mm-navlink--cta:hover{background:var(--mm-ink);color:var(--mm-on-ink)}
	.mm-lang{display:inline-flex;margin-left:var(--space-xs);font-weight:700;border:var(--mm-hair) solid var(--mm-ink)}
	.mm-lang-btn{
		border:none;background:none;padding:var(--space-3xs) var(--space-2xs);cursor:pointer;font:inherit;
		color:var(--mm-ink);text-decoration:none;
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-lang-btn:hover{background:var(--mm-paper)}
	.mm-lang-btn + .mm-lang-btn{border-left:var(--mm-hair) solid var(--mm-ink)}
	.mm-lang-btn[data-active="1"]{background:var(--mm-ink);color:var(--mm-on-ink)}
	@media (max-width:760px){
		/* Apilado ocupa demasiado alto para dejarlo fijo: en móvil se queda quieto. */
		.mm-header{flex-direction:column;gap:var(--space-xs);padding:var(--space-xs) var(--space-sm);position:static}
		.mm-nav{flex-wrap:wrap;justify-content:center}
	}
</style>
