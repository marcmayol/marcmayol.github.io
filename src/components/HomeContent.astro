---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { speakerTopics, marqueeItems, talkAudienceTags } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const talks = speakerTopics[lang];
const tags = talkAudienceTags[lang];
// Duplicamos las palabras para que el marquee haga bucle sin costuras
const marquee = [...marqueeItems[lang], ...marqueeItems[lang]];
---

<div class="mm-home mm-slab">

	<!-- HERO -->
	<section id="top" class="mm-hero">
		<div class="mm-hero-copy">
			<span class="mm-badge">{t('home.herobadge')}</span>
			<h1 class="mm-h1">
				{t('home.heroline1')}<br />
				{t('home.heroline2')}<br />
				<span class="mm-red">{t('home.heroline3')}</span>
			</h1>
			<p class="mm-hero-desc">{t('home.herodesc')}</p>
			<div class="mm-hero-cta">
				<a href="#contacto" class="mm-btn mm-btn--ink">{t('home.cta1')}</a>
				<a href="#charlas" class="mm-btn mm-btn--red">{t('home.cta2')}</a>
			</div>
		</div>
		<div class="mm-hero-photo">
			<img class="mm-hero-img" src="/perfil.png" alt={t('home.photoalt')} width="720" height="900" fetchpriority="high" />
			<div class="mm-whoami" aria-hidden="true">$ whoami<span class="mm-cursor"></span></div>
			<div class="mm-stackbar">{t('home.herostack')}</div>
		</div>
	</section>

	<!-- MARQUEE · decorativo: se pausa al pasar por encima y con reduced-motion -->
	<div class="mm-marquee" aria-hidden="true">
		<div class="mm-marquee-track">
			{marquee.map((w) => (
				<><span class="mm-marquee-item">{w}</span><span class="mm-star">★</span></>
			))}
		</div>
	</div>

	<!-- STATS -->
	<div class="mm-stats">
		<div class="mm-stat"><div class="mm-stat-num">+6</div><div class="mm-stat-lbl">{t('home.statyears')}</div></div>
		<div class="mm-stat"><div class="mm-stat-num">10+</div><div class="mm-stat-lbl">{t('home.stattalks')}</div></div>
		<div class="mm-stat"><div class="mm-stat-num">∞</div><div class="mm-stat-lbl">{t('home.statcuriosity')}</div></div>
		<a class="mm-stat mm-stat--news" href="https://www.linkedin.com/in/marc-mayol-orell/" target="_blank" rel="noopener noreferrer">
			<div class="mm-stat-news">NEWSLETTER</div><div class="mm-stat-lbl mm-stat-lbl--news">{t('home.statnews')}</div>
		</a>
	</div>

	<!-- SERVICIOS -->
	<section id="servicios" class="mm-services">
		<div class="mm-sec-head">
			<h2 class="mm-sec-tag">{t('home.servtag')}</h2>
			<p class="mm-sec-sub">{t('home.servintro')}</p>
		</div>
		<div class="mm-serv-grid">
			<div class="mm-serv mm-serv--lead">
				<h3 class="mm-serv-title">{t('home.serv1title')}</h3>
				<p class="mm-serv-desc">{t('home.serv1desc')}</p>
			</div>
			<div class="mm-serv">
				<h3 class="mm-serv-title">{t('home.serv2title')}</h3>
				<p class="mm-serv-desc">{t('home.serv2desc')}</p>
			</div>
			<div class="mm-serv">
				<h3 class="mm-serv-title">{t('home.serv3title')}</h3>
				<p class="mm-serv-desc">{t('home.serv3desc')}</p>
			</div>
		</div>
	</section>

	<!-- CHARLAS -->
	<section id="charlas" class="mm-talks">
		<div class="mm-sec-head">
			<h2 class="mm-sec-tag">{t('home.talkstag')}</h2>
		</div>
		<p class="mm-talks-intro">{t('home.talksintro')}</p>
		<div class="mm-talks-list">
			{talks.map((talk, i) => (
				<a href="#contacto" class="mm-talk">
					<h3 class="mm-talk-title">
						<span class="mm-talk-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>{talk.title}
					</h3>
					<span class="mm-talk-aud">{tags[i]} →</span>
				</a>
			))}
		</div>
	</section>

	<!-- NEWSLETTER + BLOG -->
	<div class="mm-split">
		<div class="mm-split-cell mm-split-cell--news">
			<h2 class="mm-sec-tag">{t('home.newstag')}</h2>
			<h3 class="mm-split-title">{t('home.newsblocktitle')}</h3>
			<p class="mm-split-desc">{t('home.newsblockdesc')}</p>
			<a href="https://www.linkedin.com/in/marc-mayol-orell/" target="_blank" rel="noopener noreferrer" class="mm-btn mm-btn--ink">{t('home.newsblockbtn')}</a>
		</div>
		<div class="mm-split-cell">
			<h2 class="mm-sec-tag">{t('home.blogtag')}</h2>
			<h3 class="mm-split-title">{t('home.blogblocktitle')}</h3>
			<p class="mm-split-desc">{t('home.blogblockdesc')}</p>
			<a href={`/blog/${lang}/`} class="mm-btn mm-btn--outline">{t('home.blogblockbtn')}</a>
		</div>
	</div>

	<!-- CONTACTO -->
	<section id="contacto" class="mm-contact">
		<div class="mm-contact-copy">
			<h2 class="mm-contact-title" set:html={t('home.contactbigtitle')}></h2>
			<p class="mm-contact-desc">{t('home.contactbigdesc')}</p>
		</div>
		<div class="mm-contact-btns">
			<a href={`/contacto/${lang}/`} class="mm-cbtn mm-cbtn--red">{t('nav.contact')}</a>
			<a href="https://www.linkedin.com/in/marc-mayol-orell/" target="_blank" rel="noopener noreferrer" class="mm-cbtn">LINKEDIN</a>
			<a href="https://github.com/marcmayol" target="_blank" rel="noopener noreferrer" class="mm-cbtn">GITHUB</a>
		</div>
	</section>

</div>

<style>
	/* HERO */
	.mm-hero{display:grid;grid-template-columns:1.4fr minmax(0,1fr);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-hero-copy{padding:var(--space-3xl) var(--mm-pad-x);border-right:var(--mm-border) solid var(--mm-ink);min-width:0}
	.mm-h1{
		font-size:var(--text-display);line-height:.94;font-weight:900;letter-spacing:-.03em;
		margin:0 0 var(--space-md);text-transform:uppercase;overflow-wrap:anywhere;
	}
	.mm-hero-desc{
		font-family:var(--mm-font-mono);font-size:var(--text-base);line-height:1.65;color:var(--mm-body);
		max-width:470px;margin:0 0 var(--space-lg);
	}
	.mm-hero-cta{display:flex;flex-wrap:wrap;gap:0}
	.mm-hero-photo{position:relative;min-height:400px;background:var(--mm-ink)}
	.mm-hero-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
	.mm-whoami{
		position:absolute;top:var(--space-xs);right:var(--space-xs);font-family:var(--mm-font-mono);font-size:var(--text-2xs);
		color:var(--mm-on-ink);background:oklch(18.09% 0.0054 39.3 / .72);padding:var(--space-3xs) var(--space-2xs);
	}
	.mm-cursor{display:inline-block;width:7px;height:13px;background:var(--mm-accent);margin-left:var(--space-3xs);vertical-align:middle;animation:mm-blink 1.1s steps(1) infinite}
	.mm-stackbar{
		position:absolute;bottom:0;left:0;right:0;background:var(--mm-accent);color:var(--mm-on-ink);
		font-family:var(--mm-font-mono);font-size:var(--text-2xs);font-weight:700;padding:var(--space-2xs) var(--space-sm);
		border-top:var(--mm-border) solid var(--mm-ink);
	}

	/* MARQUEE */
	.mm-marquee{overflow:hidden;background:var(--mm-ink);color:var(--mm-paper);border-bottom:var(--mm-border) solid var(--mm-ink);white-space:nowrap}
	.mm-marquee-track{display:inline-block;font-family:var(--mm-font-mono);font-weight:700;font-size:var(--text-sm);padding:var(--space-xs) 0;animation:mm-marquee 22s linear infinite}
	.mm-marquee:hover .mm-marquee-track,
	.mm-marquee:focus-within .mm-marquee-track{animation-play-state:paused}
	.mm-marquee-item{padding:0 var(--space-md)}
	.mm-star{color:var(--mm-paper)}

	/* SERVICIOS · la primera celda pesa más: rompe la rejilla de tres iguales */
	.mm-services{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink);scroll-margin-top:96px}
	.mm-serv-grid{display:grid;grid-template-columns:1.4fr minmax(0,1fr) minmax(0,1fr);border:var(--mm-border) solid var(--mm-ink)}
	.mm-serv{padding:var(--space-md);border-right:var(--mm-border) solid var(--mm-ink);min-width:0}
	.mm-serv:last-child{border-right:none}
	.mm-serv--lead{background:var(--mm-paper-2);padding:var(--space-lg) var(--space-md)}
	.mm-serv-title{font-weight:800;font-size:var(--text-lg);margin:0 0 var(--space-2xs);text-transform:uppercase;overflow-wrap:anywhere}
	.mm-serv--lead .mm-serv-title{font-size:var(--text-xl);line-height:1.05}
	.mm-serv-desc{font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-body-2);line-height:1.6;margin:0}

	/* CHARLAS */
	.mm-talks{padding:var(--space-2xl) var(--mm-pad-x);border-bottom:var(--mm-border) solid var(--mm-ink);scroll-margin-top:96px}
	.mm-talks-intro{font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-body);max-width:620px;margin:0 0 var(--space-md);line-height:1.6}
	.mm-talks-list{font-family:var(--mm-font-mono)}
	.mm-talk{
		text-decoration:none;color:var(--mm-ink);display:flex;justify-content:space-between;align-items:center;gap:var(--space-sm);
		padding:var(--space-sm) 0;border-top:var(--mm-hair) solid var(--mm-rule);
		transition:color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-talk:last-child{border-bottom:var(--mm-hair) solid var(--mm-rule)}
	.mm-talk:hover .mm-talk-title,.mm-talk:hover .mm-talk-aud{color:var(--mm-accent-ink)}
	.mm-talk-title{font-weight:700;font-size:var(--text-md);margin:0;min-width:0;overflow-wrap:anywhere}
	.mm-talk-num{color:var(--mm-muted);margin-right:var(--space-sm)}
	.mm-talk-aud{color:var(--mm-muted);font-size:var(--text-xs);white-space:nowrap}

	/* SPLIT NEWSLETTER + BLOG */
	.mm-split{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);border-bottom:var(--mm-border) solid var(--mm-ink)}
	.mm-split-cell{padding:var(--space-xl) var(--mm-pad-x)}
	.mm-split-cell--news{border-right:var(--mm-border) solid var(--mm-ink);background:var(--mm-paper-2)}
	.mm-split-title{font-weight:800;font-size:var(--text-xl);margin:var(--space-sm) 0 var(--space-2xs);text-transform:uppercase;line-height:1.05;overflow-wrap:anywhere}
	.mm-split-desc{font-family:var(--mm-font-mono);font-size:var(--text-sm);color:var(--mm-body-2);line-height:1.6;margin:0 0 var(--space-md)}

	/* RESPONSIVE */
	@media (max-width:860px){
		.mm-hero{grid-template-columns:1fr}
		.mm-hero-copy{border-right:none;border-bottom:var(--mm-border) solid var(--mm-ink);padding:var(--space-xl) var(--mm-pad-x)}
		.mm-h1{font-size:var(--text-4xl)}
		.mm-serv-grid{grid-template-columns:1fr}
		.mm-serv{border-right:none;border-bottom:var(--mm-border) solid var(--mm-ink)}
		.mm-serv:last-child{border-bottom:none}
		.mm-split{grid-template-columns:1fr}
		.mm-split-cell--news{border-right:none;border-bottom:var(--mm-border) solid var(--mm-ink)}
		.mm-services,.mm-talks{padding:var(--space-xl) var(--mm-pad-x)}
	}
	@media (max-width:520px){
		.mm-h1{font-size:var(--text-3xl)}
		.mm-talk{flex-direction:column;align-items:flex-start;gap:var(--space-3xs)}
	}
</style>
