---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const currentYear = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// En la página de contacto el formulario ya es la llamada: el pie no la repite.
const onContact = Astro.url.pathname.includes('/contacto');
---

<!-- Hallmark · footer: Ft5 Statement · design-system: design.md -->
<footer class="mm-footer">
	{!onContact && (
		<>
			<p class="mm-foot-line">{t('footer.statement')} <span class="mm-foot-acc">{t('footer.accent')}</span></p>
			<a href={`/contacto/${lang}/`} class="mm-foot-cta">{t('footer.cta')}</a>
		</>
	)}
	<div class="mm-foot-meta">
		<span>© {currentYear} marc mayol</span>
		<a href="https://www.linkedin.com/in/marc-mayol-orell/" rel="me noopener" target="_blank">linkedin</a>
		<a href="https://github.com/marcmayol" rel="me noopener" target="_blank">github</a>
		<a href="https://huggingface.co/natzx94" rel="me noopener" target="_blank">hugging face</a>
		<a href="/DracApps/">dracapps</a>
		<a href="/exercise-api/">exercise api</a>
		<a href="/sitemap-index.xml">sitemap</a>
	</div>
</footer>

<style>
	.mm-footer{
		max-width:var(--mm-maxw);margin:0 auto;
		padding:var(--space-4xl) var(--mm-pad-x) var(--space-xl);
		border-top:var(--mm-hair) solid var(--mm-rule);
		background:var(--mm-paper);color:var(--mm-ink);
	}
	.mm-foot-line{
		font-family:var(--mm-font-display);font-weight:500;font-size:var(--text-statement);
		line-height:1;letter-spacing:-.04em;margin:0 0 var(--space-lg);max-width:16ch;text-wrap:balance;
	}
	.mm-foot-acc{color:var(--mm-accent-ink)}
	.mm-foot-cta{
		display:inline-flex;align-items:center;min-height:48px;padding:0 22px;
		border-radius:var(--mm-radius-pill);background:var(--mm-accent);color:var(--mm-on-ink);
		font-weight:600;font-size:var(--text-base);text-decoration:none;
		transition:background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-foot-cta:hover{background:var(--mm-ink)}
	.mm-foot-meta{
		display:flex;flex-wrap:wrap;gap:var(--space-xs) var(--space-md);margin-top:var(--space-3xl);
		font-family:var(--mm-font-mono);font-size:var(--text-xs);color:var(--mm-muted);
	}
	.mm-foot-meta a{color:var(--mm-muted);white-space:nowrap;display:inline-flex;align-items:center;min-height:32px}
	.mm-foot-meta a:hover{color:var(--mm-accent-ink)}
	@media (max-width:860px){.mm-footer{padding:var(--space-3xl) var(--mm-pad-x) var(--space-lg)}}
	@media (prefers-reduced-motion:reduce){.mm-foot-cta{transition:none}}
</style>
