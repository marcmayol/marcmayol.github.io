---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
const currentYear = new Date().getFullYear();
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// En la página de contacto el formulario ya es la llamada: el pie no la repite.
const onContact = Astro.url.pathname.includes('/contacto');
---

<!-- Hallmark · footer: Ft5 Statement · design-system: design.md -->
<footer class="mm-footer">
	{!onContact && (
		<div class="mm-foot-statement">
			<p class="mm-foot-line">{t('footer.statement')}</p>
			<p class="mm-foot-sub">{t('footer.sub')}</p>
			<div class="mm-foot-btns">
				<a href={`/contacto/${lang}/`} class="mm-foot-btn mm-foot-btn--main">{t('footer.write')}</a>
				<a href="https://www.linkedin.com/in/marc-mayol-orell/" class="mm-foot-btn" rel="me noopener" target="_blank">LinkedIn</a>
				<a href="https://github.com/marcmayol" class="mm-foot-btn" rel="me noopener" target="_blank">GitHub</a>
			</div>
		</div>
	)}
	<div class="mm-foot-meta">
		<span>© {currentYear} Marc Mayol</span>
		<a href="/DracApps/">DracApps</a>
		<a href="/exercise-api/">Exercise API</a>
		<a href="https://huggingface.co/natzx94" rel="me noopener" target="_blank">Hugging Face</a>
		<a href="/sitemap-index.xml">Sitemap</a>
	</div>
</footer>

<style>
	.mm-footer{
		--mm-focus: var(--mm-ink);
		max-width:var(--mm-maxw);margin:0 auto;
		background:var(--mm-accent);color:var(--mm-on-ink);
		border-left:var(--mm-border) solid var(--mm-ink);border-right:var(--mm-border) solid var(--mm-ink);
		border-top:var(--mm-border-heavy) solid var(--mm-ink);
		padding:var(--space-4xl) var(--mm-pad-x) var(--space-lg);
	}
	.mm-foot-line{
		font-family:var(--mm-font-display);font-weight:900;font-size:var(--text-statement);
		line-height:.92;letter-spacing:-.035em;text-transform:uppercase;
		margin:0 0 var(--space-md);max-width:14ch;overflow-wrap:anywhere;min-width:0;
	}
	.mm-foot-sub{font-family:var(--mm-font-display);font-size:var(--text-lede);line-height:1.45;margin:0 0 var(--space-xl);max-width:40ch}
	.mm-foot-btns{display:flex;flex-wrap:wrap;gap:var(--space-sm);margin-bottom:var(--space-3xl)}
	.mm-foot-btn{
		font-family:var(--mm-font-mono);font-weight:700;font-size:var(--text-sm);white-space:nowrap;
		text-decoration:none;color:var(--mm-ink);background:var(--mm-paper);
		padding:var(--space-sm) var(--space-md);min-height:44px;display:inline-flex;align-items:center;
		border:var(--mm-border-heavy) solid var(--mm-ink);
		transition:background var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-foot-btn:hover{background:var(--mm-ink);color:var(--mm-on-ink)}
	.mm-foot-btn--main{background:var(--mm-ink);color:var(--mm-on-ink)}
	.mm-foot-btn--main:hover{background:var(--mm-paper);color:var(--mm-ink)}
	.mm-foot-meta{
		display:flex;flex-wrap:wrap;gap:var(--space-xs) var(--space-md);
		font-family:var(--mm-font-mono);font-size:var(--text-xs);
		border-top:var(--mm-hair) solid var(--mm-on-ink);padding-top:var(--space-md);
	}
	.mm-foot-meta a{color:var(--mm-on-ink);white-space:nowrap;min-height:24px}
	.mm-foot-meta a:hover{color:var(--mm-ink)}
	@media (max-width:860px){
		.mm-footer{padding:var(--space-2xl) var(--mm-pad-x) var(--space-lg)}
		.mm-foot-btns{margin-bottom:var(--space-2xl)}
	}
</style>
