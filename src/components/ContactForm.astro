---
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { CONTACT_ENDPOINT } from '../consts';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const topics = [
	{ id: 'consultoria', label: t('form.topicconsulting') },
	{ id: 'charla', label: t('form.topictalk') },
	{ id: 'formacion', label: t('form.topictraining') },
	{ id: 'otro', label: t('form.topicother') },
];

const texts = {
	sending: t('form.sending'),
	send: t('form.send'),
	ok: t('form.ok'),
	errRequired: t('form.errrequired'),
	errEmail: t('form.erremail'),
	errNet: t('form.errnet'),
	errField: t('form.errfield'),
};
---

<form class="mm-form" novalidate>
	<h2 class="mm-form-title">{t('form.title')}</h2>

	<div class="mm-form-grid">
		<div class="mm-field">
			<label class="mm-flabel" for="mm-name">{t('form.name')}</label>
			<input class="mm-in" id="mm-name" type="text" name="name" placeholder={t('form.nameph')} maxlength="80" autocomplete="name" required aria-describedby="mm-name-err" />
			<p class="mm-ferr" id="mm-name-err" hidden></p>
		</div>
		<div class="mm-field">
			<label class="mm-flabel" for="mm-email">{t('form.email')}</label>
			<input class="mm-in" id="mm-email" type="email" name="email" placeholder="tu@email.com" maxlength="120" autocomplete="email" required aria-describedby="mm-email-err" />
			<p class="mm-ferr" id="mm-email-err" hidden></p>
		</div>
	</div>

	<div class="mm-field">
		<label class="mm-flabel" for="mm-company">{t('form.company')}</label>
		<input class="mm-in" id="mm-company" type="text" name="companyName" placeholder={t('form.companyph')} maxlength="80" autocomplete="organization" />
	</div>

	<div class="mm-field">
		<span class="mm-flabel" id="mm-topics-label">{t('form.need')}</span>
		<div class="mm-topics" role="group" aria-labelledby="mm-topics-label">
			{topics.map((topic) => (
				<button type="button" class="mm-topic" data-topic={topic.id} aria-pressed="false">{topic.label}</button>
			))}
		</div>
		<input type="hidden" name="topic" value="" />
	</div>

	<div class="mm-field">
		<label class="mm-flabel" for="mm-message">{t('form.message')}</label>
		<textarea class="mm-in mm-textarea" id="mm-message" name="message" rows="5" placeholder={t('form.messageph')} maxlength="2000" required aria-describedby="mm-message-err"></textarea>
		<p class="mm-ferr" id="mm-message-err" hidden></p>
	</div>

	{/* Trampa para bots: invisible y fuera del foco. Un humano nunca lo rellena. */}
	<div class="mm-hp" aria-hidden="true">
		<label>Website<input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
	</div>

	<button class="mm-submit" type="submit">{t('form.send')}</button>
	<p class="mm-status" role="status" aria-live="polite"></p>
</form>

<script define:vars={{ endpoint: CONTACT_ENDPOINT, texts }}>
	document.querySelectorAll('.mm-form').forEach((form) => {
		const status = form.querySelector('.mm-status');
		const button = form.querySelector('.mm-submit');
		const topicInput = form.querySelector('input[name="topic"]');
		const openedAt = Date.now();

		const setStatus = (message, kind) => {
			status.textContent = message;
			status.dataset.kind = kind;
		};

		// El error vive junto a su campo: el usuario ve cuál falla, no un aviso genérico.
		const setFieldError = (field, message) => {
			const box = form.querySelector(`#${field.id}-err`);
			if (!box) return;
			if (message) {
				box.textContent = message;
				box.hidden = false;
				field.setAttribute('aria-invalid', 'true');
			} else {
				box.textContent = '';
				box.hidden = true;
				field.removeAttribute('aria-invalid');
			}
		};

		const clearErrors = () => {
			form.querySelectorAll('.mm-in').forEach((field) => setFieldError(field, ''));
		};

		// Al corregir, el error desaparece solo.
		form.querySelectorAll('.mm-in').forEach((field) => {
			field.addEventListener('input', () => {
				if (field.getAttribute('aria-invalid') === 'true') setFieldError(field, '');
			});
		});

		form.querySelectorAll('.mm-topic').forEach((chip) => {
			chip.addEventListener('click', () => {
				const isOn = topicInput.value === chip.dataset.topic;
				topicInput.value = isOn ? '' : chip.dataset.topic;
				form.querySelectorAll('.mm-topic').forEach((other) => {
					const active = !isOn && other === chip;
					other.dataset.active = active ? '1' : '0';
					other.setAttribute('aria-pressed', String(active));
				});
			});
		});

		form.addEventListener('submit', async (event) => {
			event.preventDefault();
			clearErrors();

			const data = new FormData(form);
			const nameField = form.querySelector('#mm-name');
			const emailField = form.querySelector('#mm-email');
			const messageField = form.querySelector('#mm-message');

			const name = (data.get('name') || '').trim();
			const email = (data.get('email') || '').trim();
			const message = (data.get('message') || '').trim();

			const failed = [];
			if (!name) failed.push([nameField, texts.errField]);
			if (!email) failed.push([emailField, texts.errField]);
			else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) failed.push([emailField, texts.errEmail]);
			if (!message) failed.push([messageField, texts.errField]);

			if (failed.length > 0) {
				failed.forEach(([field, message]) => setFieldError(field, message));
				setStatus(texts.errRequired, 'err');
				failed[0][0].focus();
				return;
			}

			// Bot: fingimos éxito para no enseñarle qué le ha delatado.
			if ((data.get('website') || '') !== '') {
				setStatus(texts.ok, 'ok');
				form.reset();
				return;
			}

			button.disabled = true;
			button.textContent = texts.sending;
			setStatus('', '');

			// urlencoded en vez de JSON: es una petición "simple" y el navegador
			// se ahorra el preflight OPTIONS contra el webhook.
			const body = new URLSearchParams({
				name,
				email,
				message,
				company: (data.get('companyName') || '').trim(),
				topic: data.get('topic') || 'otro',
				lang: document.documentElement.lang || '',
				page: location.pathname,
				elapsed: String(Math.round((Date.now() - openedAt) / 1000)),
			});

			try {
				const response = await fetch(endpoint, { method: 'POST', body });
				if (!response.ok) throw new Error(`HTTP ${response.status}`);
				setStatus(texts.ok, 'ok');
				form.reset();
				form.querySelectorAll('.mm-topic').forEach((chip) => {
					chip.dataset.active = '0';
					chip.setAttribute('aria-pressed', 'false');
				});
				topicInput.value = '';
			} catch {
				setStatus(texts.errNet, 'err');
			} finally {
				button.disabled = false;
				button.textContent = texts.send;
			}
		});
	});
</script>

<style>
	/* Hallmark · genre: atmospheric · macrostructure: single band (form) · design-system: design.md · designed-as-app */
	.mm-form{display:flex;flex-direction:column;gap:var(--space-md);font-family:var(--mm-font-body);color:var(--mm-ink)}
	.mm-form-title{font-family:var(--mm-font-display);font-size:var(--text-xl);font-weight:500;letter-spacing:-.02em;line-height:1.2;margin:0}
	.mm-form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-md)}
	.mm-field{display:flex;flex-direction:column;min-width:0}
	.mm-flabel{font-size:var(--text-sm);font-weight:500;color:var(--mm-ink-soft);margin-bottom:var(--space-2xs)}
	.mm-in{
		width:100%;box-sizing:border-box;min-height:48px;
		font-family:var(--mm-font-body);font-size:var(--text-md);font-weight:400;line-height:1.4;
		padding:var(--space-xs) var(--space-sm);
		border:var(--mm-hair) solid var(--mm-rule);border-radius:var(--mm-radius-sm);
		background:var(--mm-paper-2);color:var(--mm-ink);
		transition:border-color var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-in::placeholder{color:var(--mm-muted)}
	.mm-in:hover{border-color:var(--mm-muted)}
	/* El foco engorda el borde además de teñirlo: no depende sólo del color. */
	.mm-in:focus{border-color:var(--mm-accent);box-shadow:inset 0 0 0 1px var(--mm-accent);outline:none}
	.mm-in:focus-visible{outline:3px solid var(--mm-focus);outline-offset:2px}
	.mm-in[aria-invalid="true"]{border-color:var(--mm-accent);box-shadow:inset 0 0 0 1px var(--mm-accent)}
	.mm-textarea{resize:vertical;min-height:152px;line-height:1.55}
	.mm-ferr{font-size:var(--text-sm);font-weight:500;color:var(--mm-accent-ink);margin:var(--space-2xs) 0 0}

	.mm-topics{display:flex;flex-wrap:wrap;gap:var(--space-2xs)}
	.mm-topic{
		cursor:pointer;display:inline-flex;align-items:center;min-height:44px;padding:0 var(--space-sm);
		border:var(--mm-hair) solid var(--mm-rule);border-radius:var(--mm-radius-pill);
		background:var(--mm-paper-2);color:var(--mm-ink-soft);
		font-family:var(--mm-font-body);font-size:var(--text-base);font-weight:500;
		transition:border-color var(--mm-dur-1) var(--mm-ease-out),color var(--mm-dur-1) var(--mm-ease-out),background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-topic:hover{border-color:var(--mm-accent);color:var(--mm-ink)}
	.mm-topic[data-active="1"]{background:var(--mm-accent);border-color:var(--mm-accent);color:var(--mm-on-ink)}

	.mm-hp{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}

	.mm-submit{
		align-self:flex-start;cursor:pointer;display:inline-flex;align-items:center;min-height:48px;padding:0 22px;
		border:0;border-radius:var(--mm-radius-pill);background:var(--mm-accent);color:var(--mm-on-ink);
		font-family:var(--mm-font-body);font-weight:600;font-size:var(--text-base);
		transition:background var(--mm-dur-1) var(--mm-ease-out);
	}
	.mm-submit:hover:not(:disabled){background:var(--mm-ink)}
	.mm-submit:disabled{opacity:.6;cursor:progress}
	.mm-status{font-size:var(--text-base);font-weight:500;margin:0;min-height:1.5em;line-height:1.5}
	.mm-status[data-kind="ok"]{color:var(--mm-ok)}
	.mm-status[data-kind="err"]{color:var(--mm-accent-ink)}

	@media (max-width:560px){
		.mm-form-grid{grid-template-columns:minmax(0,1fr)}
		.mm-submit{align-self:stretch;justify-content:center}
	}
	@media (prefers-reduced-motion:reduce){.mm-in,.mm-topic,.mm-submit{transition:none}}
</style>
